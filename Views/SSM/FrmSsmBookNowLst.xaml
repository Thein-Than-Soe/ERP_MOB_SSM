<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="CS.ERP_MOB.Views.SSM.FrmSsmBookNowLst"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:CS.ERP_MOB.Views.Frame"
    xmlns:general="clr-namespace:CS.ERP_MOB.General">

    <ScrollView x:Name="MainScrollView">
        <VerticalStackLayout Padding="15" Spacing="15">

            <!--  =====================================================  -->
            <!--  SECTION 1 : CUSTOMER & DATE  -->
            <!--  =====================================================  -->

            <Frame
                Padding="15"
                BorderColor="LightGray"
                CornerRadius="10"
                HasShadow="False">

                <VerticalStackLayout Spacing="12">

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        HorizontalOptions="Fill">

                        <!--  Customer  -->
                        <Picker
                            x:Name="PickerCustomer"
                            Title="Select Customer"
                            Grid.Column="0"
                            HorizontalOptions="Fill"
                            IsEnabled="{Binding IsServiceEditable}"
                            ItemDisplayBinding="{Binding CustomerName_0_255}"
                            ItemsSource="{Binding CustomerList}"
                            SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                            ToolTipProperties.Text="Please enter Customer" />

                        <!--  Customer Contact  -->
                        <Picker
                            x:Name="PickerCustomerContact"
                            Title="Select Contact"
                            Grid.Column="1"
                            HorizontalOptions="Fill"
                            IsEnabled="{Binding IsServiceEditable}"
                            ItemDisplayBinding="{Binding ContactName_0_255}"
                            ItemsSource="{Binding CustomerContactList}"
                            SelectedItem="{Binding SelectedCustomerContact, Mode=TwoWay}"
                            ToolTipProperties.Text="Please enter CustomerContact" />

                    </Grid>
                    <!--  Order Date  -->
                    <VerticalStackLayout HorizontalOptions="FillAndExpand" Spacing="5">
                        <Border Stroke="{StaticResource BorderColor}" StrokeThickness="1">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="5" />
                            </Border.StrokeShape>

                            <Grid
                                Padding="5,0"
                                ColumnDefinitions="Auto,*,*"
                                VerticalOptions="Center">

                                <Label
                                    Margin="10"
                                    FontFamily="{StaticResource FontAwesomeSolid}"
                                    FontSize="15"
                                    HorizontalOptions="Center"
                                    Text="&#xf073;"
                                    TextColor="Black"
                                    VerticalOptions="Center" />

                                <DatePicker
                                    x:Name="OrderDatePicker"
                                    Grid.Column="1"
                                    Date="{Binding OrderDate, Mode=TwoWay}"
                                    FontSize="12"
                                    HeightRequest="40"
                                    IsEnabled="{Binding IsServiceEditable}" />

                                <TimePicker
                                    x:Name="OrderTimePicker"
                                    Grid.Column="2"
                                    FontSize="12"
                                    HeightRequest="40"
                                    IsEnabled="{Binding IsServiceEditable}"
                                    Time="{Binding OrderTime, Mode=TwoWay}" />

                            </Grid>
                        </Border>
                    </VerticalStackLayout>


                </VerticalStackLayout>

            </Frame>


            <!--  =====================================================  -->
            <!--  SECTION 2 : SERVICE BOOKING  -->
            <!--  =====================================================  -->

            <Frame
                x:Name="ServiceSection"
                Padding="15"
                BorderColor="LightGray"
                CornerRadius="10"
                HasShadow="False"
                IsVisible="{Binding IsCustomerSelected}">

                <VerticalStackLayout Spacing="12">

                    <!--  Section Header  -->
                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Grid.Column="0"
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Service"
                            TextColor="Black"
                            VerticalOptions="Center" />

                        <!--  PLUS BUTTON  -->
                        <Frame
                            x:Name="ServiceButton"
                            Grid.Column="1"
                            Padding="0"
                            BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                            BorderColor="Gray"
                            CornerRadius="22"
                            HeightRequest="44"
                            IsEnabled="{Binding IsServiceEditable}"
                            IsVisible="{Binding IsServiceNotAdded}"
                            WidthRequest="44">

                            <Label
                                FontFamily="{StaticResource FontAwesomeSolid}"
                                FontSize="15"
                                HorizontalOptions="Center"
                                Text="&#xf067;"
                                TextColor="White"
                                VerticalOptions="Center">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="btn_addService" />
                                </Label.GestureRecognizers>

                            </Label>

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="btn_addService" />
                            </Frame.GestureRecognizers>

                        </Frame>

                    </Grid>

                    <BoxView
                        Margin="0,4"
                        HeightRequest="1"
                        Color="LightGray" />

                    <!--  Empty Message  -->
                    <Label
                        x:Name="EmptyItemLabel"
                        FontSize="14"
                        HorizontalOptions="Center"
                        IsVisible="{Binding IsServiceNotAdded}"
                        Text="No service added yet."
                        TextColor="Gray" />

                    <!--  Single Service Card  -->
                    <!--  File: Views/SSM/FrmSsmBookNowLst.xaml  -->

                    <!--  Single Service Card  -->
                    <VerticalStackLayout
                        x:Name="ServiceCard"
                        IsVisible="{Binding IsServiceAdded}"
                        Spacing="0">

                        <Border
                            Margin="0,5"
                            Padding="12"
                            BackgroundColor="{Binding ThemeSettingCardView.PropertiesBgColor, Source={x:Static general:Common.mCommon}}"
                            Stroke="#E0E0E0"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="1">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ServiceCard_Tapped" />
                            </Border.GestureRecognizers>

                            <Grid
                                ColumnDefinitions="*,Auto"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="8">

                                <!--  ================================================  -->
                                <!--  Row 1 : Item Name / Number  -->
                                <!--  ================================================  -->

                                <HorizontalStackLayout
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Spacing="5">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding SelectedStock.StockName_0_255}"
                                        TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}" />

                                    <Label
                                        FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding SelectedStock.StockCode_0_50}"
                                        TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}"
                                        VerticalOptions="Center" />

                                </HorizontalStackLayout>


                                <!--  ================================================  -->
                                <!--  Row 2 : Left Details  -->
                                <!--  ================================================  -->

                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Spacing="4">

                                    <!--  Qty  -->
                                    <HorizontalStackLayout Spacing="5">

                                        <Label
                                            FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                            Text="Qty:"
                                            TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}"
                                            WidthRequest="60" />

                                        <Label
                                            FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                            Text="{Binding ConverterQuantity}"
                                            TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}" />

                                    </HorizontalStackLayout>


                                    <!--  UOM  -->
                                    <HorizontalStackLayout Spacing="5">

                                        <Label
                                            FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                            Text="UOM:"
                                            TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}"
                                            WidthRequest="60" />

                                        <Label
                                            FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                            Text="{Binding ItemUOM}"
                                            TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}" />

                                    </HorizontalStackLayout>


                                    <!--  Price  -->
                                    <HorizontalStackLayout Spacing="5">

                                        <Label
                                            FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                            Text="Price:"
                                            TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}"
                                            WidthRequest="60" />

                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                            TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}">
                                            <Label.Text>
                                                <MultiBinding Converter="{StaticResource AmountCurrencyConverter}">
                                                    <Binding Path="SelectedCurrency" />
                                                    <Binding Path="SelectedPrice" />
                                                </MultiBinding>
                                            </Label.Text>
                                        </Label>
                                    </HorizontalStackLayout>

                                </VerticalStackLayout>


                                <!--  ================================================  -->
                                <!--  Row 2 : Amount  -->
                                <!--  ================================================  -->

                                <VerticalStackLayout
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    HorizontalOptions="End"
                                    Spacing="2"
                                    VerticalOptions="Center">

                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                        TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}">
                                        <Label.Text>
                                            <MultiBinding Converter="{StaticResource AmountCurrencyConverter}">
                                                <Binding Path="SelectedCurrency" />
                                                <Binding Path="Subtotal" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </VerticalStackLayout>

                            </Grid>

                        </Border>


                        <!--  Assign Person  -->
                        <HorizontalStackLayout
                            Margin="10,0,10,8"
                            HorizontalOptions="End"
                            IsVisible="{Binding HasAssignedUser}"
                            Spacing="5">

                            <Label
                                FontSize="13"
                                Text="Assign to :"
                                TextColor="{Binding ThemeSettingContent.PropertiesFontColor, Source={Static Member=general:Common.mCommon}}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="{Binding AssignedUser.UserName_0_255}"
                                TextColor="{Binding ThemeSettingContent.PropertiesFontColor, Source={Static Member=general:Common.mCommon}}" />

                        </HorizontalStackLayout>

                        <!--  Recurring Person  -->
                        <HorizontalStackLayout
                            Margin="10,0,10,8"
                            HorizontalOptions="End"
                            IsVisible="{Binding HasSelectedBeatType}"
                            Spacing="5">

                            <Label
                                FontSize="13"
                                Text="Recurring :"
                                TextColor="{Binding ThemeSettingContent.PropertiesFontColor, Source={Static Member=general:Common.mCommon}}" />

                            <Label
                                FontAttributes="Bold"
                                FontSize="13"
                                Text="{Binding SelectedBeatType.BeatTypeName_0_255}"
                                TextColor="{Binding ThemeSettingContent.PropertiesFontColor, Source={Static Member=general:Common.mCommon}}" />

                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </VerticalStackLayout>

            </Frame>

            <!--  =====================================================  -->
            <!--  SECTION 4 : INVOICE  -->
            <!--  =====================================================  -->

            <Frame
                x:Name="InvoiceSection"
                Padding="15"
                BorderColor="LightGray"
                CornerRadius="10"
                HasShadow="False"
                IsVisible="{Binding IsServiceAdded}">

                <VerticalStackLayout Spacing="12">

                    <!--  Subtotal  -->
                    <Grid ColumnDefinitions="*,Auto">

                        <Label Grid.Column="0" Text="Subtotal" />
                        <Label Grid.Column="1">
                            <Label.Text>
                                <MultiBinding Converter="{StaticResource AmountCurrencyConverter}">
                                    <Binding Path="SelectedCurrency" />
                                    <Binding Path="Subtotal" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>

                    </Grid>


                    <!--  Discount  -->
                    <Grid
                        Margin="0,5,0,0"
                        ColumnDefinitions="*,Auto"
                        IsVisible="{Binding HasDiscount}">

                        <!--  Left : Discount - 9%  -->
                        <HorizontalStackLayout
                            Grid.Column="0"
                            Spacing="3"
                            VerticalOptions="Center">

                            <Label Text="Discount" VerticalOptions="Center" />

                            <Picker
                                x:Name="PickerDiscount"
                                Title="$"
                                ItemDisplayBinding="{Binding DiscountTypeName_0_255}"
                                ItemsSource="{Binding DiscountRules}"
                                SelectedItem="{Binding SelectedRule, Mode=TwoWay}"
                                TextColor="Black"
                                ToolTipProperties.Text="Discount type"
                                VerticalOptions="Center"
                                WidthRequest="25" />
                            <Entry
                                x:Name="EntRate"
                                Keyboard="Numeric"
                                Text="{Binding DiscountRate, Mode=TwoWay, StringFormat='{0:0.00}'}"
                                TextColor="Black"
                                ToolTipProperties.Text="Discount rate"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                        <Label Grid.Column="1">
                            <Label.Text>
                                <MultiBinding Converter="{StaticResource AmountCurrencyConverter}">
                                    <Binding Path="SelectedCurrency" />
                                    <Binding Path="DiscountAmount" />
                                </MultiBinding>
                            </Label.Text>
                        </Label>

                    </Grid>



                    <!--  =====================================================  -->
                    <!--  GST  -->
                    <!--  =====================================================  -->

                    <Grid
                        Margin="0,5,0,0"
                        ColumnDefinitions="*,*,Auto"
                        ColumnSpacing="5">

                        <!--  GST + Switch  -->
                        <HorizontalStackLayout
                            Grid.Column="0"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                Text="GST"
                                VerticalOptions="Center" />

                            <Switch IsToggled="{Binding IsGSTEnabled, Mode=TwoWay}" VerticalOptions="Center" />

                        </HorizontalStackLayout>

                        <!--  GST Method  -->
                        <Picker
                            Title="GST Method"
                            Grid.Column="1"
                            Margin="35,0,0,0"
                            HeightRequest="40"
                            IsVisible="{Binding IsGSTEnabled}"
                            ItemDisplayBinding="{Binding GSTMethodName}"
                            ItemsSource="{Binding GSTMethodList}"
                            SelectedItem="{Binding SelectedGSTMethod, Mode=TwoWay}" />

                        <!--  GST Amount  -->
                        <Label
                            Grid.Column="2"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                            <Label.Text>
                                <MultiBinding Converter="{StaticResource AmountCurrencyConverter}">
                                    <Binding Path="SelectedCurrency" />
                                    <Binding Path="TaxAmount" />
                                </MultiBinding>
                            </Label.Text>

                        </Label>




                    </Grid>


                    <!--  =====================================================  -->
                    <!--  ROUND OFF  -->
                    <!--  =====================================================  -->

                    <Grid
                        Margin="0,5,0,0"
                        ColumnDefinitions="*,Auto"
                        VerticalOptions="Center">

                        <!--  Round Off + Switch  -->
                        <HorizontalStackLayout
                            Grid.Column="0"
                            Spacing="5"
                            VerticalOptions="Center">

                            <Label
                                FontAttributes="Bold"
                                Text="Round Off"
                                VerticalOptions="Center" />

                            <Switch IsToggled="{Binding IsRoundOffEnabled, Mode=TwoWay}" VerticalOptions="Center" />

                        </HorizontalStackLayout>


                        <!--  Round Off Amount  -->
                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            VerticalOptions="Center">

                            <Label.Text>
                                <MultiBinding Converter="{StaticResource AmountCurrencyConverter}">
                                    <Binding Path="SelectedCurrency" />
                                    <Binding Path="RoundOffAmount" />
                                </MultiBinding>
                            </Label.Text>

                        </Label>

                    </Grid>


                    <!--  =====================================================  -->
                    <!--  SEPARATOR  -->
                    <!--  =====================================================  -->

                    <BoxView
                        Margin="0,5,0,0"
                        HeightRequest="1"
                        Color="LightGray" />


                    <!--  =====================================================  -->
                    <!--  GRAND TOTAL  -->
                    <!--  =====================================================  -->

                    <Grid Margin="0,5" ColumnDefinitions="*,Auto">

                        <Label
                            FontAttributes="Bold"
                            FontSize="18"
                            Text="Grand Total" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="16">

                            <Label.Text>
                                <MultiBinding Converter="{StaticResource AmountCurrencyConverter}">
                                    <Binding Path="SelectedCurrency" />
                                    <Binding Path="GrandTotal" />
                                </MultiBinding>
                            </Label.Text>

                        </Label>

                    </Grid>

                </VerticalStackLayout>

            </Frame>


            <!--  =====================================================  -->
            <!--  SECTION 5 : PAYMENT METHODS  -->
            <!--  =====================================================  -->

            <VerticalStackLayout
                Margin="0,0,0,0"
                IsVisible="{Binding IsServiceAdded}"
                Spacing="8">

                <!--  Payment Header  -->
                <Border
                    Padding="8"
                    BackgroundColor="{Binding ThemeSettingCardView.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                    Stroke="{StaticResource BorderColor}"
                    StrokeThickness="1">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="5"
                        VerticalOptions="Center">

                        <!--  Payment Title  -->
                        <Label
                            Margin="20,0,0,0"
                            FontAttributes="Bold"
                            Text="Payment"
                            TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={Static Member=general:Common.mCommon}}"
                            VerticalOptions="Center" />

                        <!--  Add Payment  -->
                        <Frame
                            Grid.Column="1"
                            Padding="0"
                            BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                            BorderColor="Gray"
                            HeightRequest="40"
                            WidthRequest="40">

                            <Label
                                FontFamily="{StaticResource FontAwesomeSolid}"
                                FontSize="15"
                                HorizontalOptions="Center"
                                Text="&#xf067;"
                                TextColor="White"
                                VerticalOptions="Center" />

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AddPayment_Clicked" />
                            </Frame.GestureRecognizers>
                        </Frame>

                        <!--  Payment List Dropdown Toggle  -->
                        <Frame
                            Grid.Column="2"
                            Padding="0"
                            BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                            BorderColor="Gray"
                            HeightRequest="40"
                            VerticalOptions="Center"
                            WidthRequest="40">

                            <Label
                                x:Name="Payment_DropdownToggleIcon"
                                FontFamily="{StaticResource FontAwesomeSolid}"
                                FontSize="15"
                                HorizontalOptions="Center"
                                Text="&#xf078;"
                                TextColor="White"
                                VerticalOptions="Center" />

                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPaymentDropdownToggleTapped" />
                            </Frame.GestureRecognizers>

                        </Frame>

                    </Grid>
                </Border>


                <!--  =================================================  -->
                <!--  PAYMENT LIST DROPDOWN  -->
                <!--  =================================================  -->

                <Frame
                    x:Name="Payment_DropdownContent"
                    Margin="10,0"
                    Padding="10"
                    BackgroundColor="#F9F9F9"
                    BorderColor="#CCCCCC"
                    CornerRadius="8"
                    IsVisible="False">

                    <Grid RowDefinitions="Auto,*">

                        <!--  No Payment  -->
                        <Label
                            Grid.Row="0"
                            Padding="5"
                            HorizontalOptions="Center"
                            IsVisible="{Binding PaymentList.Count, Converter={StaticResource ZeroToBoolConverter}}"
                            Text="No payment added."
                            TextColor="Gray" />

                        <!--  Payment List  -->
                        <CollectionView
                            x:Name="payment_lstView"
                            Grid.Row="1"
                            ItemsSource="{Binding PaymentList}"
                            SelectionMode="None"
                            VerticalOptions="Fill">

                            <CollectionView.ItemTemplate>
                                <DataTemplate>

                                    <Border
                                        Margin="0,3"
                                        Padding="10"
                                        BackgroundColor="{Binding ThemeSettingCardView.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                                        Stroke="#DDDDDD"
                                        StrokeThickness="1">

                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="8" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="payment_lstView_ItemSelected" />
                                        </Border.GestureRecognizers>


                                        <Grid
                                            Padding="10"
                                            ColumnDefinitions="*,Auto"
                                            ColumnSpacing="10">

                                            <!--  Payment Type  -->
                                            <Label
                                                Grid.Column="0"
                                                FontAttributes="Bold"
                                                FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                                Text="{Binding PaymentTypeName_0_255}"
                                                TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}"
                                                VerticalOptions="Center" />

                                            <!--  Deposit Amount  -->
                                            <Label
                                                Grid.Column="1"
                                                FontAttributes="Bold"
                                                FontSize="{Binding ThemeSettingCardView.PropertiesFontSize, Source={x:Static general:Common.mCommon}}"
                                                TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={x:Static general:Common.mCommon}}"
                                                VerticalOptions="Center">

                                                <Label.Text>
                                                    <MultiBinding Converter="{StaticResource AmountCurrencyConverter}">
                                                        <Binding Path="SelectedCurrency" />
                                                        <Binding Path="DepositAmount" />
                                                    </MultiBinding>
                                                </Label.Text>

                                            </Label>

                                        </Grid>

                                    </Border>

                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </Grid>

                </Frame>
            </VerticalStackLayout>
            <!--  =================================================  -->
            <!--  COMPLETE BOOKING  -->
            <!--  =================================================  -->
            <Frame
                x:Name="SaveBookNowButton"
                Grid.Column="1"
                Padding="0"
                BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                BorderColor="Gray"
                CornerRadius="22"
                HeightRequest="40"
                IsEnabled="{Binding IsServiceAdded}"
                WidthRequest="120">

                <Label
                    FontSize="15"
                    HorizontalOptions="Center"
                    Text="Book Now"
                    TextColor="White"
                    VerticalOptions="Center">

                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="btn_SaveBookNow_Tapped" />
                    </Label.GestureRecognizers>

                </Label>

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="btn_SaveBookNow_Tapped" />
                </Frame.GestureRecognizers>

            </Frame>


        </VerticalStackLayout>

    </ScrollView>

</ContentView>