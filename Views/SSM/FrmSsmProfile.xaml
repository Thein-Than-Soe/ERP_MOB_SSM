                        <RoundRectangle CornerRadius="8" />
                    </Border.StrokeShape>

                    <Grid
                        ColumnDefinitions="*,Auto,Auto"
                        ColumnSpacing="5"
                        VerticalOptions="Center">

                        <!--  Left Text  -->
                        <HorizontalStackLayout>
                            <Label
                                Margin="20,0,0,0"
                                FontAttributes="Bold"
                                Text="{Binding Source={ext:LanguageExtension Key=JOB.JobProfile.lbl.Contact}, Path=Value}"
                                TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={Static Member=general:Common.mCommon}}"
                                VerticalOptions="Center" />
                            <Label VerticalOptions="Center">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span
                                            FontSize="14"
                                            Text="    -   "
                                            TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={Static Member=general:Common.mCommon}}" />
                                        <Span
                                            FontSize="14"
                                            Text="{Binding Contact_count}"
                                            TextColor="{Binding ThemeSettingCardView.PropertiesFontColor, Source={Static Member=general:Common.mCommon}}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </HorizontalStackLayout>


                        <!--  Plus Icon  -->
                        <Frame
                            Grid.Column="1"
                            Padding="0"
                            BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                            BorderColor="Gray"
                            HeightRequest="40"
                            WidthRequest="40">
                            <Label
                                FontFamily="{StaticResource FontAwesomeSolid}"
                                FontSize="15"
                                HorizontalOptions="Center"
                                Text="&#xf067;"
                                TextColor="White"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="AddContact_Clicked" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="AddContact_Clicked" />
                            </Frame.GestureRecognizers>
                        </Frame>

                        <!--  Dropdown Toggle Icon  -->
                        <Frame
                            Grid.Column="2"
                            Padding="0"
                            BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                            BorderColor="Gray"
                            HeightRequest="40"
                            VerticalOptions="Center"
                            WidthRequest="40">
                            <Label
                                x:Name="Contact_DropdownToggleIcon"
                                FontFamily="{StaticResource FontAwesomeSolid}"
                                FontSize="15"
                                HorizontalOptions="Center"
                                Text="&#xf078;"
                                TextColor="White"
                                VerticalOptions="Center">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnContactDropdownToggleTapped" />
                                </Label.GestureRecognizers>
                            </Label>
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnContactDropdownToggleTapped" />
                            </Frame.GestureRecognizers>
                        </Frame>

                    </Grid>
                </Border>
                <!--  Contact Dropdown  -->
                <Frame
                    x:Name="Contact_DropdownContent"
                    Margin="10,0,10,0"
                    Padding="10"
                    BackgroundColor="#F9F9F9"
                    BorderColor="#CCCCCC"
                    CornerRadius="8"
                    IsVisible="False">

                    <ListView
                        x:Name="contact_lstView"
                        HorizontalOptions="Fill"
                        IsPullToRefreshEnabled="True"
                        ItemSelected="contact_lstView_ItemSelected"
                        ItemsSource="{Binding ApplicantContact}"
                        RowHeight="90"
                        SeparatorVisibility="None"
                        VerticalOptions="Center">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <SwipeView
                                        Margin="0,3"
                                        Padding="10"
                                        BackgroundColor="AntiqueWhite">
                                        <VerticalStackLayout
                                            Grid.Column="0"
                                            Spacing="2"
                                            VerticalOptions="CenterAndExpand">
                                            <!--  Text Blocks  -->
                                            <Label
                                                FontSize="14"
                                                LineBreakMode="TailTruncation"
                                                Text="{Binding ContactTypeName_0_255}"
                                                TextColor="{Binding ThemeSettingCardViewHeader.PropertiesFontColor, Source={Static Member=general:Common.mCommon}}" />


                                            <Label FontSize="14" LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span Text="{Binding CountryMobileCode_0_50}" />
                                                        <Span Text=" - " />
                                                        <Span FontSize="12" Text="{Binding Mobile}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>
                                            <Label FontSize="14" LineBreakMode="TailTruncation">
                                                <Label.FormattedText>
                                                    <FormattedString>
                                                        <Span FontSize="12" Text="{Binding CityName_0_255}" />
                                                        <Span Text=", " />
                                                        <Span FontSize="12" Text="{Binding StateName_0_255}" />
                                                        <Span Text=", " />
                                                        <Span FontSize="12" Text="{Binding CountryName_0_255}" />
                                                    </FormattedString>
                                                </Label.FormattedText>
                                            </Label>

                                        </VerticalStackLayout>
                                    </SwipeView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                </Frame>


            </VerticalStackLayout>
        </VerticalStackLayout>

    </ScrollView>
</ContentView>