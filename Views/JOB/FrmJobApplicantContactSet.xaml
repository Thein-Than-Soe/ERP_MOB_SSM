<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CS.ERP_MOB.Views.JOB.FrmJobApplicantContactSet"
             xmlns:general="clr-namespace:CS.ERP_MOB.General"
             xmlns:touch="http://axemasta.com/schemas/2023/toucheffect"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:CS.ERP_MOB.Extensions"
             xmlns:local="clr-namespace:CS.ERP_MOB.Views.JOB"
             Title="Contact Edit">


    <Grid RowDefinitions="*,Auto">
        <!-- Form area -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="25">

                <!-- ContactTypeName_0_255 -->
                <VerticalStackLayout>
                    <Label Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.lbl.ContactType}, Path=Value}" FontAttributes="Bold"/>
                    <Picker x:Name="PickerContactType"
                            Title="{Binding Source={ext:LanguageExtension Key=JOB.Common.plh.Select}, Path=Value}"
                            ItemsSource="{Binding ContactTypeList}"
                            ItemDisplayBinding="{Binding ContactTypeName_0_255}" />
                    <HorizontalStackLayout 
                        Spacing="4" 
                        Margin="5,0,0,0">
                        <Label Text="&#xf05a;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="12" />
                        <Label Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.ifo.ContactType}, Path=Value}"
                               FontSize="12"
                               TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Email address -->
                <VerticalStackLayout>
                    <!-- 🔹 Field Label (Localized) -->
                    <Label 
                        Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.lbl.Email}, Path=Value}" 
                        FontAttributes="Bold" />

                    <!-- 🔹 Entry with Validation Behavior -->
                    <Entry x:Name="EntryEmail" Placeholder="Enter Email">
                        <Entry.Behaviors>
                            <toolkit:TextValidationBehavior x:Name="EmailValidator"
                            Flags="ValidateOnValueChanged"
                            MinimumLength="0"
                            MaximumLength="255"
                            InvalidStyle="{StaticResource InvalidEntryStyle}" />
                        </Entry.Behaviors>
                    </Entry>

                    <!-- ℹ️ Static Hint Info -->
                    <HorizontalStackLayout 
                        Spacing="4" 
                        Margin="5,0,0,0">
                        <Label Text="&#xf05a;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="12" />
                        <Label 
                            Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.ifo.Email}, Path=Value}"
                            FontSize="12"
                            TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- User Phone (Country Code + Number) -->
                <VerticalStackLayout>
                    <!-- 🔹 Field Label (Localized) -->
                    <Label 
                        Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.lbl.Mobile}, Path=Value}" 
                        FontAttributes="Bold" />

                    <!-- 🔹 Entry with Validation Behavior -->
                    <Grid ColumnDefinitions="Auto,*" VerticalOptions="Center">
                        <Picker 
                            x:Name="PickerCountryCode"
                            Grid.Column="0"
                            FontSize="14"
                            WidthRequest="60"
                            HeightRequest="40"
                            Title="{Binding Source={ext:LanguageExtension Key=JOB.Common.plh.Select}, Path=Value}"
                            ItemsSource="{Binding CountryList}"
                            ItemDisplayBinding="{Binding CountryMobileCode_0_50}" />
                        <Entry Grid.Column="1" Placeholder="Phone Number" x:Name="entPhoneNumber" FontSize="14" Keyboard="Telephone" HeightRequest="40"/>
                    </Grid>


                    <!-- ℹ️ Static Hint Info -->
                    <HorizontalStackLayout 
                        Spacing="4" 
                        Margin="5,0,0,0">
                        <Label Text="&#xf05a;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="12" />
                        <Label 
                            Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.ifo.Mobile}, Path=Value}"
                            FontSize="12"
                            TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Location Address -->
                <VerticalStackLayout Spacing="2">
                    <!-- 🔹 Field Label (Localized) -->
                    <Label 
                        Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.lbl.Location}, Path=Value}" 
                        FontAttributes="Bold" />

                    <!-- 🔹 Entry with Validation Behavior -->
                    <Grid ColumnDefinitions="*,*,*">
                        <Picker x:Name="PickerCountry"
                            Grid.Column="0"
                            Title="{Binding Source={ext:LanguageExtension Key=HCM.Contact.lbl.Country}, Path=Value}"
                            ItemsSource="{Binding CountryList}"
                            ItemDisplayBinding="{Binding CountryName_0_255}"
                            SelectedItem="{Binding SelectedCountry, Mode=TwoWay}" />

                        <Picker x:Name="PickerState"
                            Grid.Column="1"
                            Title="{Binding Source={ext:LanguageExtension Key=HCM.Contact.lbl.State}, Path=Value}"
                            ItemsSource="{Binding SelectedCountry.RES_STATE_DTL}"
                            ItemDisplayBinding="{Binding StateName_0_255}"
                            SelectedItem="{Binding SelectedState, Mode=TwoWay}" />

                        <Picker x:Name="PickerCity"
                            Grid.Column="2"
                            Title="{Binding Source={ext:LanguageExtension Key=HCM.Contact.lbl.City}, Path=Value}"
                            ItemsSource="{Binding SelectedState.RES_CITY}"
                            ItemDisplayBinding="{Binding CityName_0_255}"
                            SelectedItem="{Binding SelectedCity, Mode=TwoWay}" />

                    </Grid> 
                    <!-- ℹ️ Static Hint Info -->
                    <HorizontalStackLayout 
                        Spacing="4" 
                        Margin="5,0,0,0">
                        <Label Text="&#xf05a;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="12" />
                        <Label 
                            Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.ifo.Location}, Path=Value}"
                            FontSize="12"
                            TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>


                <!-- Email address -->
                <VerticalStackLayout>
                    <!-- 🔹 Field Label (Localized) -->
                    <Label 
                        Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.lbl.Address}, Path=Value}" 
                        FontAttributes="Bold" />

                    <!-- 🔹 Entry with Validation Behavior -->
                    <Entry x:Name="EntryAddress" Placeholder="Enter Address">
                        <Entry.Behaviors>
                            <toolkit:TextValidationBehavior x:Name="AddressValidator"
                            Flags="ValidateOnValueChanged"
                            MinimumLength="0"
                            MaximumLength="255"
                            InvalidStyle="{StaticResource InvalidEntryStyle}" />
                        </Entry.Behaviors>
                    </Entry>

                    <!-- ℹ️ Static Hint Info -->
                    <HorizontalStackLayout 
                        Spacing="4" 
                        Margin="5,0,0,0">
                        <Label Text="&#xf05a;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="12" />
                        <Label 
                            Text="{Binding Source={ext:LanguageExtension Key=HCM.Contact.ifo.Address}, Path=Value}"
                            FontSize="12"
                            TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>


        <!-- Fixed Bottom Box -->
        <Grid HeightRequest="50"
              Grid.Row="1"
                BackgroundColor="AntiqueWhite"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                ColumnDefinitions="*"
                Padding="20,0">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <!-- Save button -->
                <Frame
                Padding="10,7"
                CornerRadius="5"
                HasShadow="True"
                BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                    <!-- Tap Gesture -->
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer 
                            Tapped="OnSaveBtn_Clicked" 
                            NumberOfTapsRequired="1" />
                    </Frame.GestureRecognizers>


                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Text="&#xf0c7;" 
                           Grid.Column="0"
                           FontFamily="{StaticResource FontAwesomeSolid}"
                           FontSize="18"
                           TextColor="White"
                           VerticalOptions="Center" />

                        <!-- Text -->
                        <Label 
                        Grid.Column="1"
                        Text="Save"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="White"
                        VerticalOptions="Center" />
                    </Grid>
                </Frame>
                <!-- Apply button -->
                <Frame
                Padding="10,7"
                CornerRadius="5"
                BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                HasShadow="True"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                    <!-- Tap Gesture -->
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer 
                            Tapped="OnDeleteBtn_Clicked" 
                            NumberOfTapsRequired="1" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Text="&#xf1f8;" 
                           Grid.Column="0"
                           FontFamily="{StaticResource FontAwesomeSolid}"
                           FontSize="18"
                           TextColor="White"
                           VerticalOptions="Center" />

                        <!-- Text -->
                        <Label 
                        Grid.Column="1"
                        Text="Delete"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="White"
                        VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </HorizontalStackLayout>


        </Grid>
    </Grid>

</ContentPage>