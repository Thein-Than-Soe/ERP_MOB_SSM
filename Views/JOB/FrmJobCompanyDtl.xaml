<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dg="clr-namespace:Maui.DataGrid;assembly=Maui.DataGrid"
    xmlns:local="clr-namespace:CS.ERP_MOB.Views.JOB"
    xmlns:touch="http://axemasta.com/schemas/2023/toucheffect"
    xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:general="clr-namespace:CS.ERP_MOB.General"
    xmlns:ext="clr-namespace:CS.ERP_MOB.Extensions"
    xmlns:Effects="clr-namespace:RGPopup.Maui.Effects;assembly=RGPopup.Maui"
    x:Class="CS.ERP_MOB.Views.JOB.FrmJobCompanyDtl"
    Title="Company Detail">


    <Grid RowDefinitions="*,Auto">
        <!-- Scrollable Content -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="10">
                <HorizontalStackLayout VerticalOptions="Center" BackgroundColor="AntiqueWhite">
                    <!-- Company Image -->
                    <Frame 
                        Grid.Row="0"
                        Grid.Column="0"
                        HeightRequest="100"
                        WidthRequest="100"
                        Padding="0"
                        CornerRadius="0"
                        Margin="0,0,10,0"
                        IsClippedToBounds="True">

                        <Image
                            Source="{Binding SelectedCompany.CompanyLogo}"
                            Aspect="AspectFill"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill">
                        </Image>

                    </Frame>

                    <!-- Company Info -->
                    <VerticalStackLayout VerticalOptions="Center" Spacing="5">
                        <Label Text="{Binding SelectedCompany.CompanyName_0_255}" LineBreakMode="CharacterWrap" FontAttributes="Bold" FontSize="16" />

                        <Label IsVisible="{Binding SelectedCompany.CompanySlogan, Converter={StaticResource StringExistsConverter}}" LineBreakMode="CharacterWrap">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="     &quot;" FontSize="16" />
                                    <Span Text="{Binding SelectedCompany.CompanySlogan}"  FontSize="14" FontAttributes="Italic"/>
                                    <Span Text="&quot;" FontSize="16" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                        <Label Text="{Binding SelectedCompany.CompanyTypeName_0_255}" FontSize="12" Margin="0,8"
                               IsVisible="{Binding SelectedCompany.CompanyTypeName_0_255, Converter={StaticResource StringExistsConverter}}"/>
                    </VerticalStackLayout>

                </HorizontalStackLayout>

                <!-- Rating row -->
                <HorizontalStackLayout 
                    Spacing="4"
                    VerticalOptions="Start"
                    HorizontalOptions="Start">
                    <Label Text="&#xf005;"
                        FontSize="15"
                        FontFamily="{StaticResource Key=FontAwesomeSolid}"
                        TextColor="{Binding ThemeSettingContent.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center">
                    </Label>
                    <Label Text="{Binding SelectedCompany.TotalRate}" FontSize="12" />
                    <Label Text="{Binding SelectedCompany.ReviewCount}" FontSize="12" Margin="15,0,0,0" />
                    <Label Text="{Binding Source={ext:LanguageExtension Key=JOB.JobCompany.lbl.reviews}, Path=Value}" FontSize="12" />
                </HorizontalStackLayout>

                <!-- Break -->
                <BoxView HeightRequest="1" BackgroundColor="Gray" HorizontalOptions="FillAndExpand" Margin="0,10"/>


                <!-- Overview -->
                <VerticalStackLayout Spacing="15">
                    <Label Text="Company Overview" FontAttributes="Bold" FontSize="16" Margin="0,0,0,10"/>

                    <Grid ColumnDefinitions="120, *"
                          IsVisible="{Binding SelectedCompany.CompanyWebsite, Converter={StaticResource StringExistsConverter}}">
                        <Label Text="Website" 
                               FontAttributes="Bold" />
                        <Label Text="{Binding SelectedCompany.CompanyWebsite}"
                               Grid.Column="1"
                                TextColor="Blue"
                                TextDecorations="Underline"
                               FontAttributes="Italic">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding BindingContext.OpenWebsiteCommand, Source={RelativeSource AncestorType={x:Type local:FrmJobCompanyDtl}}}"
                                    CommandParameter="{Binding SelectedCompany.CompanyWebsite}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                    <Grid ColumnDefinitions="120, *"
                          IsVisible="{Binding SelectedCompany.Email, Converter={StaticResource StringExistsConverter}}">
                        <Label Text="Email" 
                               FontAttributes="Bold" />
                        <Label Text="{Binding SelectedCompany.Email}"
                               Grid.Column="1"
                               FontAttributes="Italic">
                        </Label>
                    </Grid>

                    <Grid ColumnDefinitions="120, *"
                          IsVisible="{Binding SelectedCompany.CompanyRegSDate, Converter={StaticResource StringExistsConverter}}">
                        <Label Text="Registration Date" 
                               FontAttributes="Bold"/>
                        <Label Text="{Binding SelectedCompany.CompanyRegSDate}" 
                               Grid.Column="1"/>
                    </Grid>

                    <Grid ColumnDefinitions="120, *"
                          IsVisible="{Binding SelectedCompany.Phone, Converter={StaticResource StringExistsConverter}}">
                        <Label Text="Contact no." FontAttributes="Bold"/>
                        <Label Grid.Column="1">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding SelectedCompany.CountryMobileCode_0_50}" />
                                    <Span Text="   "  FontSize="14" />
                                    <Span Text="{Binding SelectedCompany.Phone}"  FontSize="14" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Grid>

                    <Grid ColumnDefinitions="120, *"
                          IsVisible="{Binding SelectedCompany.Address, Converter={StaticResource StringExistsConverter}}">
                        <Label Text="Address" 
                               FontAttributes="Bold" />
                        <Label Text="{Binding SelectedCompany.Address}" 
                               Grid.Column="1"/>
                    </Grid>
                </VerticalStackLayout>

                <VerticalStackLayout IsVisible="{Binding SelectedCompany.CompanyDescription_0_500, Converter={StaticResource StringExistsConverter}}">
                    <!-- Break -->
                    <BoxView HeightRequest="1" BackgroundColor="Gray" HorizontalOptions="FillAndExpand" Margin="0,15,0,10"/>
                    <!-- Description -->
                    <Label Text="Company Description" FontAttributes="Bold" FontSize="16" Margin="0,0,0,10"/>
                    <Label Text="{Binding SelectedCompany.CompanyDescription_0_500}" />
                </VerticalStackLayout>
                

                <!-- Break -->
                <BoxView HeightRequest="1" BackgroundColor="Gray" HorizontalOptions="FillAndExpand" Margin="0,15,0,10"/>
                <!-- Available Job List Section -->

                <Grid ColumnDefinitions="250,*" Margin="0,0,0,10" HorizontalOptions="Fill" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Available Job List" 
                           FontSize="16" 
                           FontAttributes="Bold" 
                           HorizontalOptions="Start" />
                    <Frame Grid.Column="1"
                           BackgroundColor="AntiqueWhite"
                           CornerRadius="6"
                           Padding="6,2"
                           HasShadow="False"
                           HorizontalOptions="End"
                           VerticalOptions="Center">
                        <Label HorizontalOptions="Center" VerticalOptions="Center">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="Total " FontSize="14" />
                                    <Span Text="{Binding SelectedCompany.JobCount}" FontSize="14" />
                                    <Span Text="  jobs" FontSize="14" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </Frame>
                </Grid>

                <!-- Available Job Lists -->

                <ListView
                    VerticalOptions="Center"
                    HorizontalOptions="Fill"
                    x:Name="lstView"
                    ItemsSource="{Binding JobVacancyList}"
                    RowHeight="100"
                    SeparatorVisibility="None"
                    IsPullToRefreshEnabled="True"
                    Margin="0,0,0,50"
                    ItemSelected="lstView_ItemSelected">

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <ViewCell>
                                    <SwipeView>
                                        <Grid 
                                            Padding="10"
                                            Margin="0,5"
                                            BackgroundColor="LightGray">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Left Column -->
                                            <VerticalStackLayout Spacing="2" Grid.Column="0" VerticalOptions="CenterAndExpand" >
                                                <!-- Top Text Blocks -->
                                                <Label Text="{Binding DesignationName_0_255}"
                                                    TextColor="DarkRed"
                                                    FontSize="14"
                                                    LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding CompanyName_0_255}"
                                                    TextColor="Gray"
                                                    FontSize="{Binding ThemeSettingContent.PropertiesFontSize, Source={Static Member=general:Common.mCommon}}"
                                                    LineBreakMode="TailTruncation"/>

                                                <HorizontalStackLayout Spacing="5">
                                                    <Label Text="{Binding CityName_0_255}"
                                                        FontSize="{Binding ThemeSettingContent.PropertiesFontSize, Source={Static Member=general:Common.mCommon}}"
                                                        LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding CountryName_0_255}"
                                                        FontSize="12" 
                                                        LineBreakMode="TailTruncation" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding VacancyAvailabilityName_0_255}"
                                                    FontSize="{Binding ThemeSettingContent.PropertiesFontSize, Source={Static Member=general:Common.mCommon}}"
                                                    FontFamily="{StaticResource Key=FontAwesomeSolid}"
                                                    LineBreakMode="TailTruncation"/>
                                            </VerticalStackLayout>

                                            <!-- Right Column -->
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="FillAndExpand">

                                                <!-- Start date Option -->
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="&#xf251;"
                                                        FontSize="13"
                                                        TextColor="Grey"
                                                        FontFamily="{StaticResource Key=FontAwesomeSolid}"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Center">
                                                    </Label>
                                                    <Label Text="{Binding SD}" 
                                                        VerticalOptions="Center" 
                                                        FontSize="12"/>

                                                </HorizontalStackLayout>

                                                <!-- End date Option -->
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="&#xf253;"
                                                       FontSize="13"
                                                       TextColor="Grey"
                                                       FontFamily="{StaticResource Key=FontAwesomeSolid}"
                                                       VerticalOptions="Center"
                                                       HorizontalOptions="Center">
                                                    </Label>
                                                    <Label Text="{Binding ED}" 
                                                        VerticalOptions="Center" 
                                                        FontSize="12" />

                                                </HorizontalStackLayout>
                                                <Label Text="{Binding VacancyStatusName_0_255}"
                                                    FontSize="12"
                                                    TextColor="Gray"
                                                    HorizontalOptions="End"
                                                    VerticalOptions="Center"/>
                                            </VerticalStackLayout>


                                        </Grid>
                                    </SwipeView>
                                </ViewCell>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                </ListView>


            </VerticalStackLayout>
        
        </ScrollView>
        <!-- Fixed Bottom Box -->
        <Grid HeightRequest="50"
                BackgroundColor="AntiqueWhite"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                Padding="20,0">
            <!-- Save button -->
            <Frame
                Padding="10,7"
                CornerRadius="5"
                BackgroundColor="{Binding SaveButtonColor}"
                HasShadow="True"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer 
                            Command="{Binding BindingContext.SaveItemCommand, 
                            Source={RelativeSource AncestorType={x:Type local:FrmJobCompanyDtl}}}"
                            CommandParameter="{Binding SelectedCompany}" />
                </Frame.GestureRecognizers>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    
                    <Label Text="&#xf0c7;" 
                            FontFamily="{StaticResource FontAwesomeSolid}"
                            FontSize="18"
                            TextColor="White"
                            VerticalOptions="Center" />

                    <!-- Text -->
                    <Label 
                        Grid.Column="1"
                        Text="{Binding SaveButtonText}"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="White"
                        VerticalOptions="Center" />
                </Grid>

            </Frame>
        </Grid>
    </Grid>

</ContentPage>