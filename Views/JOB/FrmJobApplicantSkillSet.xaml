<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CS.ERP_MOB.Views.JOB.FrmJobApplicantSkillSet"
             xmlns:general="clr-namespace:CS.ERP_MOB.General"
             xmlns:touch="http://axemasta.com/schemas/2023/toucheffect"
             xmlns:material="http://schemas.enisn-projects.io/dotnet/maui/uraniumui/material"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:ext="clr-namespace:CS.ERP_MOB.Extensions"
             xmlns:local="clr-namespace:CS.ERP_MOB.Views.JOB"
             Title="Applicant Skill Set Edit">


    <Grid RowDefinitions="*,Auto">
        <!-- Form area -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <!-- SkillSet -->
                <VerticalStackLayout Spacing="0">
                    <!-- 🔹 Field Label (Localized) -->
                    <Label 
                        Text="{Binding Source={ext:LanguageExtension Key=HCM.Skill.lbl.SkillSet}, Path=Value}" 
                        FontAttributes="Bold"/>

                    <!-- 🔹 Entry with Validation Behavior -->
                    <Entry x:Name="EntrySkill" Placeholder="Enter major">
                        <Entry.Behaviors>
                            <toolkit:TextValidationBehavior
                                            Flags="ValidateOnValueChanged"
                                            MinimumLength="0"
                                            MaximumLength="255"
                                            InvalidStyle="{StaticResource InvalidEntryStyle}" />
                        </Entry.Behaviors>
                    </Entry>

                    <!-- ℹ️ Static Hint Info -->
                    <HorizontalStackLayout 
                        Spacing="4" 
                        Margin="5,0,0,0">
                        <Label Text="&#xf05a;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="12" />
                        <Label Text="{Binding Source={ext:LanguageExtension Key=HCM.Skill.ifo.SkillSet}, Path=Value}"
                            FontSize="12"
                            TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Skill level -->
                <VerticalStackLayout>
                    <Label Text="{Binding Source={ext:LanguageExtension Key=HCM.Skill.lbl.SkillLevel}, Path=Value}" FontAttributes="Bold"/>
                    <Picker x:Name="PickerSkillLevel"
                            Title="{Binding Source={ext:LanguageExtension Key=JOB.Common.plh.Select}, Path=Value}"
                            ItemsSource="{Binding SkillLevelList}"
                            ItemDisplayBinding="{Binding SkillLevelName_0_255}" />
                    <HorizontalStackLayout 
                        Spacing="4" 
                        Margin="5,0,0,0">
                        <Label Text="&#xf05a;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="12" />
                        <Label Text="{Binding Source={ext:LanguageExtension Key=HCM.Skill.ifo.SkillLevel}, Path=Value}"
                               FontSize="12"
                               TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Reference -->
                <VerticalStackLayout>
                    <!-- 🔹 Field Label (Localized) -->
                    <Label 
                        Text="{Binding Source={ext:LanguageExtension Key=HCM.Skill.lbl.ReferenceNo}, Path=Value}" 
                        FontAttributes="Bold" />

                    <!-- 🔹 Entry with Validation Behavior -->
                    <Entry x:Name="EntryReference" Placeholder="Enter reference">
                        <Entry.Behaviors>
                            <toolkit:TextValidationBehavior x:Name="ReferenceValidator"
                            Flags="ValidateOnValueChanged"
                            MinimumLength="0"
                            MaximumLength="255"
                            InvalidStyle="{StaticResource InvalidEntryStyle}" />
                        </Entry.Behaviors>
                    </Entry>

                    <!-- ℹ️ Static Hint Info -->
                    <HorizontalStackLayout 
                        Spacing="4" 
                        Margin="5,0,0,0">
                        <Label Text="&#xf05a;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="12" />
                        <Label 
                            Text="{Binding Source={ext:LanguageExtension Key=HCM.Skill.ifo.ReferenceNo}, Path=Value}"
                            FontSize="12"
                            TextColor="Gray" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Remark -->
                <VerticalStackLayout Spacing="2">
                    <!-- 🔹 Field Label (Localized) -->
                    <Label 
                        Text="{Binding Source={ext:LanguageExtension Key=HCM.Setup.lbl.Remark}, Path=Value}" 
                        FontAttributes="Bold" />

                    <!-- 🔹 Entry with Validation Behavior -->
                    <Entry x:Name="EntryRemark" Placeholder="{Binding Source={ext:LanguageExtension Key=HCM.Setup.plh.Remark}, Path=Value}" >
                        <Entry.Behaviors>
                            <toolkit:TextValidationBehavior x:Name="RemarkValidator"
                            Flags="ValidateOnValueChanged"
                            MinimumLength="0"
                            MaximumLength="255"
                            InvalidStyle="{StaticResource InvalidEntryStyle}" />
                        </Entry.Behaviors>
                    </Entry>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>


        <!-- Fixed Bottom Box -->
        <Grid HeightRequest="50"
              Grid.Row="1"
                BackgroundColor="AntiqueWhite"
                VerticalOptions="End"
                HorizontalOptions="Fill"
                ColumnDefinitions="*"
                Padding="20,0">
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <!-- Save button -->
                <Frame
                Padding="10,7"
                CornerRadius="5"
                HasShadow="True"
                BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                HorizontalOptions="Center"
                VerticalOptions="Center">

                    <!-- Tap Gesture -->
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer 
                            Tapped="OnSaveBtn_Clicked" 
                            NumberOfTapsRequired="1" />
                    </Frame.GestureRecognizers>


                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Text="&#xf0c7;" 
                           Grid.Column="0"
                           FontFamily="{StaticResource FontAwesomeSolid}"
                           FontSize="18"
                           TextColor="White"
                           VerticalOptions="Center" />

                        <!-- Text -->
                        <Label 
                        Grid.Column="1"
                        Text="Save"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="White"
                        VerticalOptions="Center" />
                    </Grid>
                </Frame>
                <!-- Apply button -->
                <Frame
                Padding="10,7"
                CornerRadius="5"
                BackgroundColor="{Binding ThemeSettingButton.PropertiesBgColor, Source={Static Member=general:Common.mCommon}}"
                HasShadow="True"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                    <!-- Tap Gesture -->
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer 
                            Tapped="OnDeleteBtn_Clicked" 
                            NumberOfTapsRequired="1" />
                    </Frame.GestureRecognizers>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Label Text="&#xf1f8;" 
                           Grid.Column="0"
                           FontFamily="{StaticResource FontAwesomeSolid}"
                           FontSize="18"
                           TextColor="White"
                           VerticalOptions="Center" />

                        <!-- Text -->
                        <Label 
                        Grid.Column="1"
                        Text="Delete"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="White"
                        VerticalOptions="Center" />
                    </Grid>
                </Frame>
            </HorizontalStackLayout>


        </Grid>
    </Grid>

</ContentPage>